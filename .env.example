# SmartTrip AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env to git.

# ── Django Security ──────────────────────────────────────────
SECRET_KEY=replace-this-with-a-long-random-secret-key

# ── Debug Mode (set to False in production) ──────────────────
DEBUG=True

# ── Allowed Hosts ────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Google Gemini API ────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database (leave blank for SQLite in local dev) ───────────
# For production, set this to your Supabase PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
